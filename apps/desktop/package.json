{
  "name": "@headspace/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src vite.config.ts scripts/dev.mjs",
    "test": "node --experimental-transform-types --test src/*.test.ts",
    "test:release": "python3 -m unittest discover -s scripts -p \"test_*.py\"",
    "native:build": "python3 scripts/release.py build"
  },
  "dependencies": {
    "@headspace/spotify": "*",
    "@hexclave/js": "1.0.113",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-table": "9.2.4",
    "@tanstack/react-virtual": "3.14.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vgpu": "0.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13"
  }
}
